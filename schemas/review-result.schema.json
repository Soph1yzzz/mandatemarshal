{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandatemarshal/review-result.schema.json",
  "title": "MandateMarshal Review Result",
  "type": "object",
  "required": ["schemaVersion", "verdict", "candidateId", "reason", "findings", "requiredAction", "residualRisk"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "verdict": { "enum": ["PASS", "FIX", "ESCALATE"] },
    "candidateId": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "reference", "message"],
        "properties": {
          "severity": { "enum": ["blocking", "warning", "info"] },
          "reference": { "type": "string" },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "requiredAction": { "type": "string" },
    "residualRisk": { "type": "string" }
  },
  "additionalProperties": false
}
