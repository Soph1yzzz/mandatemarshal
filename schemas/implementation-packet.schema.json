{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mandatemarshal/implementation-packet.schema.json",
  "title": "MandateMarshal Implementation Packet",
  "type": "object",
  "required": ["schemaVersion", "routing", "objective", "ownership", "interfaces", "constraints", "executionContract", "verification", "returnContract"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "routing": {
      "type": "object",
      "required": ["lane", "reason"],
      "properties": {
        "lane": { "enum": ["routine-implementer", "complex-implementer"] },
        "reason": { "type": "string", "minLength": 1 },
        "requestedModel": { "type": "string" },
        "requestedEffort": { "type": "string" },
        "observedModel": { "type": "string" },
        "observedEffort": { "type": "string" },
        "reclassifiedFrom": { "enum": ["routine-implementer", "complex-implementer"] },
        "reclassificationReason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "why": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": ["allowedPaths"],
      "properties": {
        "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "interfaces": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "executionContract": {
      "type": "object",
      "properties": {
        "requiredCommands": { "type": "array", "items": { "type": "object", "required": ["command"], "properties": { "command": { "type": "string" }, "success": { "type": "string" } }, "additionalProperties": false } },
        "forbiddenCommands": { "type": "array", "items": { "type": "string" } },
        "requiredFlags": { "type": "array", "items": { "type": "object", "required": ["command", "flag"], "properties": { "command": { "type": "string" }, "flag": { "type": "string" } }, "additionalProperties": false } },
        "forbiddenArtifacts": { "type": "array", "items": { "type": "object", "required": ["id", "patterns", "severity"], "properties": { "id": { "type": "string" }, "patterns": { "type": "array", "items": { "type": "string" } }, "severity": { "enum": ["blocking", "warning"] }, "enabled": { "type": "boolean" } }, "additionalProperties": false } },
        "allowedWritePaths": { "type": "array", "items": { "type": "string" } },
        "forbiddenWritePaths": { "type": "array", "items": { "type": "string" } },
        "expectedSideEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbiddenSideEffects": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "target", "success"],
        "properties": {
          "kind": { "enum": ["command", "inspect", "artifact", "custom"] },
          "target": { "type": "string" },
          "success": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "returnContract": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
