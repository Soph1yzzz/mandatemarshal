{
  "schemaVersion": 1,
  "host": "codex",
  "authority": {
    "model": "gpt-6-sol",
    "effort": "high",
    "mirrorFreshReviewer": true
  },
  "roles": {
    "parent": {
      "nativeRole": "parent",
      "model": "gpt-6-sol",
      "effort": "high"
    },
    "routineImplementer": {
      "nativeRole": "routine-implementer",
      "model": "gpt-6-luna",
      "effort": "max"
    },
    "complexImplementer": {
      "nativeRole": "complex-implementer",
      "model": "gpt-6-sol",
      "effort": "high"
    },
    "freshReviewer": {
      "nativeRole": "fresh-reviewer",
      "model": "gpt-6-sol",
      "effort": "high"
    }
  },
  "review": {
    "mandatory": true,
    "freshContextRequired": true,
    "requestedReadOnly": true
  },
  "evidence": {
    "storage": "external-user-data",
    "captureGitState": true,
    "captureCommands": true,
    "forbiddenArtifacts": [
      {
        "id": "python-bytecode-forbidden",
        "patterns": [
          "**/__pycache__/**",
          "**/*.pyc",
          "**/*.pyo"
        ],
        "severity": "blocking",
        "enabled": false
      }
    ],
    "commandPolicies": [
      {
        "id": "python-no-bytecode",
        "command": "python",
        "requiredFlags": [
          "-B"
        ],
        "enabled": false
      }
    ]
  },
  "ownerContracts": [],
  "routing": {
    "defaultLane": "routine-implementer",
    "complexityTriggers": [
      "routine-worker-blocked"
    ],
    "allowSilentFallback": false
  }
}
